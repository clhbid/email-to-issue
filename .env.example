# GitHub App — Settings > Developer Settings > GitHub Apps > your app > App ID
# Shape: integer (no quotes needed in .env, but fine as a string)
# Example: 123456
GH_APP_ID=

# GitHub App Installation ID — found in the URL after installing the app on a repo:
# github.com/organizations/clhbid/settings/installations/{this number}
# Shape: integer
# Example: 12345678
GH_INSTALLATION_ID=

# GitHub App Private Key — full contents of the downloaded .pem file,
# including the -----BEGIN RSA PRIVATE KEY----- and -----END RSA PRIVATE KEY----- lines.
# In Netlify: paste as-is; the newlines are preserved automatically.
# Shape: multiline RSA PEM string
# Example: -----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQ...
GH_PRIVATE_KEY=

# GitHub org or username that owns the target repository
# Shape: string, no slashes
# Example: clhbid
GH_OWNER=

# GitHub repository name where issues will be created
# Shape: string, no slashes
# Example: clhbid.com
GH_REPO=

# Comma-separated list of email addresses allowed to create issues.
# Emails from any other address are rejected with 403.
# Shape: comma-separated emails (no spaces required, but spaces are trimmed)
# Example: mark@clhbid.com,devteam@clhbid.com
ALLOWED_SENDERS=

# The inbound parse address that SendGrid is configured to forward to this function.
# Must exactly match the "to" field in the incoming SendGrid webhook payload.
# Shape: email address
# Example: new-issues@parse.clhbid.com
INBOUND_EMAIL=

# Google Gemini API key — get one free at https://aistudio.google.com (Get API key)
# Shape: string starting with "AIzaSy"
# Example: AIzaSyD-9tSrke72...
GEMINI_API_KEY=
